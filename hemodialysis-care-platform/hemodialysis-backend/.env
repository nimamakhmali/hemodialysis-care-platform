APP_NAME="سیستم پایش همودیالیز"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars-12345

POSTGRES_USER=hemo_user
POSTGRES_PASSWORD=hemo_password
POSTGRES_DB=hemodialysis_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hemo_user:hemo_password@localhost:5432/hemodialysis_db

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT=5
