    clinician_explanation: Mapped[str] = mapped_column(
        Text,
        nullable=False,
        comment="توضیح کامل برای کادر درمان (چرا این هشدار؟)",
    )

    # ==========================================
    # شواهد و دلیل (برای Explainability)
