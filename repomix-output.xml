                education_topic="HIGH_K",
                patient_message_draft=(
                    f"پتاسیم خون شما ({k_val} mEq/L) کمی بالاتر از حد طبیعی است. "
                    f"دقت در مصرف غذاهای پرپتاسیم را افزایش دهید."
                ),
            )

        return self._no_trigger()


class HypokalemiaRule(BaseRule):
    """
