# ============================================================
# Helper Functions
# ============================================================

def _build_patient_info(patient: Patient) -> dict:
    """اطلاعات پایه بیمار برای داشبورد"""
    from app.shared.enums import VascularAccessType

    access_fa = {
        "fistula": "فیستول",
        "graft": "گرافت",
        "catheter": "کاتتر",
    }

