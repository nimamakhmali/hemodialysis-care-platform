def analyze_diet(self, log_id: str) -> dict:
    """
    تحلیل ثبت رژیم غذایی

    بررسی می‌کند:
    - streak روزهای متوالی با رعایت POOR
    - Cross-domain با P بالا
    """
    db = _get_db()
