            f"بسیار بیشتر از حد توصیه‌شده است"
        )
    elif log.total_ml >= FLUID_THRESHOLDS.daily_max_ml:
        warnings.append(
            f"مصرف مایعات امروز ({log.total_ml} ml) "
            f"بیشتر از حد توصیه‌شده است"
        )

    return {
        "success": True,
        "data": _log_to_dict(log),
        "warnings": warnings,
        "message": "مصرف مایعات ثبت شد",
    }


