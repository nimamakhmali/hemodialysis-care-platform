Reference table: lab_reference_ranges
    test_code: LabTestCode (PK)
    unit: str
    normal_low: float
    normal_high: float
    critical_low: float (nullable)
    critical_high: float (nullable)
    valid_min: float — محدوده منطقی ورود دستی
