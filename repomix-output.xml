  className,
}: PatientSearchBarProps) {
  const [isFocused, setIsFocused] = useState(false);

  const handleClear = useCallback(() => {
    onChange("");
  }, [onChange]);

  return (
    <motion.div
      className={cn("relative flex items-center gap-2", className)}
      initial={false}
    >
      {/* Search Input Container */}
