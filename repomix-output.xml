    """سطح شدت هشدار"""
    LOW = "low"        # آموزشی / قابل مدیریت
    MEDIUM = "medium"  # نیاز به بررسی در ویزیت بعدی
    HIGH = "high"      # نیاز به توجه فوری


class AlertCategory(str, Enum):
