        )

        logger.info(
            f"تحلیل علائم {report_id} کامل شد. Alert: {len(alerts)}"
        )

        return {
            "report_id": report_id,
            "alerts_created": len(alerts),
        }

    except Exception as exc:
        logger.error(
            f"خطا در تحلیل علائم {report_id}: {exc}",
            exc_info=True,
        )
        raise self.retry(exc=exc)

    finally:
        db.close()


# ============================================================
# TASK: تحلیل مایعات
# ============================================================

@celery_app.task(
    bind=True,
    max_retries=3,
    default_retry_delay=60,
