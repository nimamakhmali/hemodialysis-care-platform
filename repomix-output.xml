          )}
        >
          {/* Search Icon */}
          <motion.div
            className="pointer-events-none absolute right-3.5"
            animate={{ color: isFocused ? "#0EA5E9" : "#94A3B8" }}
            transition={{ duration: 0.2 }}
          >
            <Search className="h-4.5 w-4.5" />
          </motion.div>

          <input
            type="text"
