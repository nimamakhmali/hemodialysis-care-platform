        },
    },
    LabTestCode.CALCIUM.value: {
        "slope_threshold": 0.2,
        "concerning_direction": "both",
        "interpretation": {
            "increasing": "روند صعودی کلسیم",
            "decreasing": "روند نزولی کلسیم",
            "stable": "کلسیم پایدار",
        },
