        # K > 5.0: خفیف
        if k_val > LAB_THRESHOLDS.k_normal_high:
            return self._make_triggered(
                severity=AlertSeverity.LOW,
                title=f"پتاسیم خفیف بالا: {k_val} mEq/L",
                clinician_explanation=(
                    f"پتاسیم = {k_val} mEq/L — کمی بالاتر از مرجع. "
