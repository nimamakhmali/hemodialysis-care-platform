export interface DialysisSessionDetail {
  id: string
  patient_id: string
  session_date: string
  session_start_time?: string
  session_end_time?: string
  duration_minutes?: number
  pre_weight: number
  post_weight?: number
  dry_weight_at_session: number
  weight_gain?: number
  uf_volume?: number
