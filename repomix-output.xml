          />
          <MetricItem
            icon={Droplets}
            label="افزایش وزن بین جلسات"
            value={lastSession?.weight_gain}
            unit="kg"
            delay={0.05}
          />
          <MetricItem
            icon={Activity}
            label="IDWG"
            value={lastSession?.idwg_percent}
            unit="%"
