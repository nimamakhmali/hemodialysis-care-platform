}

.recharts-default-legend {
  direction: rtl;
  font-family: 'Vazirmatn', sans-serif;
}

.recharts-legend-item-text {
  font-family: 'Vazirmatn', sans-serif !important;
  color: #475569 !important;
}

/* ═══════════════════════════════════════════════════════════════════════
