WEIGHT_TREND_CONFIG = {
    "slope_threshold": 0.5,  # درصد در هر جلسه
    "concerning_direction": "increasing",
    "interpretation": {
        "increasing": "روند صعودی IDWG — عدم رعایت مایعات",
        "decreasing": "روند بهبود IDWG",
